# ==============================================================================
# RSS Job Hunter Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key (Required for AI-powered feed extraction, resume parsing, and ATS matching)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (Optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# OpenAI Base URL (Optional, for OpenAI-compatible proxies or local LLMs like Ollama/vLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Candidate Resume PDF Configuration
# Specify the filename or absolute/relative path to your resume PDF
RESUME_PATH=resume.pdf
# Alias (also supported):
# RESUME=resume.pdf

# Minimum ATS match score (0-100) a job must reach before a tailored resume
# is automatically generated for it during "Find Jobs". Matches the "Good
# Match" tier boundary in the ATS scoring rubric.
MATCH_SCORE_THRESHOLD=70

# Headless runner mode (`python main.py --runner`): how many minutes to wait
# between Find Jobs pipeline cycles.
RUNNER_INTERVAL_MINUTES=30

# Pushover push notifications (https://pushover.net/) for newly matched jobs.
# Optional: only sent when BOTH values below are set. Leave unset/commented out
# to disable notifications entirely.
# PUSHOVER_API_TOKEN=your_pushover_application_token
# PUSHOVER_USER_KEY=your_pushover_user_key

# MQTT push notifications for newly matched jobs, for driving a pager-style
# display device (e.g. a LilyGO T-Display) in addition to Pushover.
# Optional: only sent when MQTT_BROKER_HOST, MQTT_USERNAME, and MQTT_PASSWORD
# are all set. Leave unset/commented out to disable.
# MQTT_BROKER_HOST=your-cluster.emqxsl.com
# MQTT_BROKER_PORT=8883
# MQTT_USERNAME=your_mqtt_username
# MQTT_PASSWORD=your_mqtt_password
# MQTT_TOPIC=jobhunter/notifications
# MQTT_USE_TLS=true
